{
  "name": "Psephology Enterprise Leadership Dashboard",
  "provider": "Amazon Quick Sight",
  "datasetView": "analytics_research_enterprise_v1",
  "qualityDatasetView": "analytics_research_quality_v1",
  "movementDatasetView": "analytics_iteration_movement_v1",
  "comparabilityDatasetView": "analytics_iteration_comparability_v1",
  "refresh": "SPICE incremental refresh every 30 minutes during survey operations",
  "globalFilters": [
    "program_name",
    "campaign_name",
    "constituency_name",
    "iteration_number",
    "mandal_name",
    "party_name",
    "gender",
    "age_band"
  ],
  "sheets": [
    {
      "name": "Leadership overview",
      "visuals": [
        { "type": "KPI", "title": "Respondent base", "measure": "distinct_count(respondent_key)" },
        { "type": "KPI", "title": "Average party-strength", "measure": "avg(direct_party_strength)" },
        { "type": "DONUT", "title": "Sentiment mix", "dimension": "respondent_sentiment", "measure": "distinct_count(respondent_key)" },
        { "type": "BAR", "title": "Party landscape", "dimension": "party_salience", "measure": "distinct_count(respondent_key)" },
        { "type": "BAR", "title": "Candidate perception", "dimension": "candidate_sentiment", "measure": "distinct_count(respondent_key)" },
        { "type": "BAR", "title": "Party leadership", "dimension": "party_leadership", "measure": "distinct_count(respondent_key)" }
      ]
    },
    {
      "name": "Demographic pulse",
      "visuals": [
        { "type": "HISTOGRAM", "title": "Respondent age distribution", "measure": "age" },
        { "type": "STACKED_BAR", "title": "Sentiment by age", "dimension": "age_band", "color": "respondent_sentiment", "measure": "distinct_count(respondent_key)" },
        { "type": "DONUT", "title": "Gender composition", "dimension": "gender", "measure": "distinct_count(respondent_key)" },
        { "type": "STACKED_BAR", "title": "Party salience by gender", "dimension": "gender", "color": "party_salience", "measure": "distinct_count(respondent_key)" }
      ]
    },
    {
      "name": "Geographic intelligence",
      "datasetView": "analytics_research_geographic_v1",
      "visuals": [
        { "type": "GEOSPATIAL_HEATMAP", "title": "Party pulse by Mandal", "latitude": "latitude", "longitude": "longitude", "weight": "heat_weight", "filter": "party_name" },
        { "type": "POINT_MAP", "title": "Party-strength by Mandal", "latitude": "latitude", "longitude": "longitude", "size": "respondent_count", "color": "party_pulse_score" },
        { "type": "HEAT_TABLE", "title": "Constituency × sentiment", "rows": "constituency_name", "columns": "respondent_sentiment", "measure": "distinct_count(respondent_key)" },
        { "type": "HEAT_TABLE", "title": "Mandal × party salience", "rows": "mandal_name", "columns": "party_salience", "measure": "distinct_count(respondent_key)" },
        { "type": "BAR", "title": "Issue priorities by constituency", "dimension": "constituency_name", "group": "issue_priority", "measure": "distinct_count(respondent_key)" }
      ]
    },
    {
      "name": "Iteration movement",
      "datasetView": "analytics_iteration_movement_v1",
      "scopeLabel": "Full consecutive Iterations; all Runs. Demographic filters do not apply to this aggregate dataset.",
      "supportedFilters": ["program_name", "campaign_name", "iteration_number"],
      "unsupportedFilters": ["mandal_name", "party_name", "gender", "age_band", "constituency_name"],
      "visuals": [
        { "type": "BAR", "title": "Qualified direct party-strength change", "dimension": "iteration_number", "group": "campaign_name", "measure": "party_strength_change", "nullHandling": "Omit unavailable deltas; never connect waves" },
        { "type": "BAR", "title": "Qualified positive-sentiment change (pp)", "dimension": "iteration_number", "group": "campaign_name", "measure": "positive_sentiment_change_pct", "nullHandling": "Omit unavailable deltas; never connect waves" },
        { "type": "BAR", "title": "Qualified candidate-positive change (pp)", "dimension": "iteration_number", "group": "campaign_name", "measure": "candidate_positive_change_pct", "nullHandling": "Omit unavailable deltas; never connect waves" },
        { "type": "TABLE", "title": "Standalone wave evidence and comparability", "dimensions": ["campaign_name", "iteration_number", "comparison_basis"], "measures": ["respondent_base", "direct_measure_base", "issue_response_base", "average_direct_party_strength", "positive_sentiment_pct", "candidate_positive_pct"] }
      ]
    },
    {
      "name": "Research quality",
      "datasetView": "analytics_research_quality_v1",
      "scopeLabel": "Whole Campaign fieldwork; not filtered by age, gender, Mandal or Run.",
      "supportedFilters": ["program_name", "campaign_name"],
      "visuals": [
        { "type": "KPI", "title": "Respondent evidence", "measure": "sum(respondent_base)" },
        { "type": "KPI", "title": "Connection rate", "measure": "weighted(connection_rate_pct, call_attempts)" },
        { "type": "KPI", "title": "Structured-output coverage", "measure": "weighted(response_coverage_pct, connected_calls)" },
        { "type": "KPI", "title": "Demographic completeness", "measure": "weighted(demographic_completeness_pct, respondent_base)" },
        { "type": "TABLE", "title": "Campaign evidence qualification", "dimensions": ["campaign_name", "evidence_quality_status", "sampling_design", "weighting_status"], "measures": ["respondent_base", "connection_rate_pct", "response_coverage_pct", "demographic_completeness_pct"] },
        { "type": "TABLE", "title": "Iteration comparability gate", "datasetView": "analytics_iteration_comparability_v1", "dimensions": ["campaign_name", "iteration_number", "comparison_status", "sampling_method", "weighting_status"], "measures": [] },
        { "type": "TEXT", "title": "Interpretation guard", "value": "Operational evidence quality only. No sampling margin of error and no constituency vote-share forecast until representative sampling and weighting are configured." }
      ]
    }
  ],
  "governance": {
    "minimumCellSize": 5,
    "mapAggregationLevel": "MANDAL",
    "mapCentroidSource": "analytics_geo_reference",
    "administrativeBoundarySource": "Telangana Remote Sensing Applications Centre (TGRAC)",
    "administrativeBoundaryLayers": [
      "STATE",
      "DISTRICT",
      "ASSEMBLY_CONSTITUENCY",
      "MANDAL"
    ],
    "demoConstituency": "AC 52 · Serilingampally",
    "publicEmbedding": false,
    "rawPiiIncluded": false,
    "qualityStatusMeaning": "Operational evidence quality; not statistical confidence",
    "movementComparisonRule": "Use analytics_iteration_comparability_v1; consecutive declared comparable waves only, with at least five respondents per wave; never bridge missing evidence",
    "forecastLabel": "Directional research evidence; not an election forecast"
  }
}
